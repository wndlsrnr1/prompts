```python
# services.py - GOOD
from django.db import transaction
from typing import Any

class OrderService:
    def __init__(self):
        self.order_repo = OrderRepository()
        self.payment_service = PaymentService()
        self.notification_service = NotificationService()
    
    @transaction.atomic
    def process_order(self, order_id: int, payment_data: dict[str, Any]) -> Order:
        order = self._load_and_validate_order(order_id)
        self._validate_payment_amount(order, payment_data)
        
        transaction = self._process_payment(order, payment_data)
        order = self._update_order_payment(order, transaction, payment_data)
        
        self._post_payment_actions(order)
        return order
    
    def _load_and_validate_order(self, order_id: int) -> Order:
        order = self.order_repo.get_by_id(order_id)
        if not order:
            raise NotFoundServiceError("Order not found")
        if order.status != 'pending':
            raise ServiceError("Order is not pending", status_code=400)
        return order
    
    def _validate_payment_amount(self, order: Order, payment_data: dict[str, Any]) -> None:
        if payment_data['amount'] != order.total:
            raise ServiceError("Payment amount mismatch", status_code=400)
    
    def _process_payment(self, order: Order, payment_data: dict[str, Any]) -> PaymentTransaction:
        if payment_data['method'] == 'credit_card':
            return self.payment_service.process_credit_card(payment_data)
        elif payment_data['method'] == 'paypal':
            return self.payment_service.process_paypal(payment_data)
        else:
            raise ServiceError("Invalid payment method", status_code=400)
    
    def _update_order_payment(self, order: Order, transaction: PaymentTransaction, payment_data: dict[str, Any]) -> Order:
        return self.order_repo.update(order, {
            'status': 'paid',
            'payment_method': payment_data['method'],
            'payment_transaction_id': transaction.id
        })
    
    def _post_payment_actions(self, order: Order) -> None:
        self.notification_service.send_confirmation_email(order)
        self.inventory_service.update_inventory(order)
```

