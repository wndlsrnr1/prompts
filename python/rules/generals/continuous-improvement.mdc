def get_popular_episodes():
    cache_key = 'popular_episodes'
    episodes = cache.get(cache_key)
    if episodes is None:
        episodes = Episode.objects.select_related('series').filter(
            status='published'
        ).order_by('-view_count')[:10]
        cache.set(cache_key, episodes, timeout=300)
    return episodes

