## Comprehensive Examples: Good vs Bad

### Example 1: User Profile Update

**BAD: Business logic in view, direct model access**
```python
# views.py - BAD
from rest_framework.views import APIView
from rest_framework.response import Response
from .models import User, Profile

class ProfileUpdateView(APIView):
    def put(self, request, user_id):
        user = User.objects.get(id=user_id)  # BAD: Direct model access
        if user.id != request.user.id:  # BAD: Business logic in view
            return Response({"error": "Unauthorized"}, status=403)
        
        profile = Profile.objects.get(user=user)  # BAD: Direct model access
        profile.name = request.data.get('name')  # BAD: Business logic
        profile.email = request.data.get('email')
        if Profile.objects.filter(email=profile.email).exclude(id=profile.id).exists():  # BAD: Complex logic
            return Response({"error": "Email exists"}, status=400)
        profile.save()
        return Response({"id": profile.id, "name": profile.name})
```

**GOOD: Thin view, service handles business logic**
```python
# views.py - GOOD
from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework.request import Request
from rest_framework import status, permissions

from .serializers import ProfileUpdateSerializer, ProfileReadSerializer
from .services.profile_service import ProfileService, ServiceError


class ProfileUpdateAPIView(APIView):
    permission_classes = [permissions.IsAuthenticated]

    def put(self, request: Request, user_id: int) -> Response:
        serializer = ProfileUpdateSerializer(data=request.data)
        serializer.is_valid(raise_exception=True)
        
        try:
            profile = ProfileService.update(user_id, serializer.validated_data, user=request.user)
        except ServiceError as exc:
            return Response({"detail": str(exc)}, status=exc.status_code)
        
        return Response(ProfileReadSerializer(profile).data, status=status.HTTP_200_OK)
```

```python
# services.py - GOOD
from django.db import transaction
from typing import Any

from .repositories.profile_repository import ProfileRepository
from .repositories.user_repository import UserRepository
from .exceptions import ServiceError, NotFoundServiceError


class ProfileService:
    def __init__(self):
        self.profile_repo = ProfileRepository()
        self.user_repo = UserRepository()
    
    @transaction.atomic
    def update(self, user_id: int, data: dict[str, Any], user: User) -> Profile:
        target_user = self.user_repo.get_by_id(user_id)
        if not target_user:
            raise NotFoundServiceError("User not found")
        
        if target_user.id != user.id:
            raise ServiceError("Unauthorized", status_code=403)
        
        profile = self.profile_repo.get_by_user(target_user)
        if not profile:
            raise NotFoundServiceError("Profile not found")
        
        if 'email' in data:
            self._validate_email_uniqueness(data['email'], profile.id)
        
        updated_profile = self.profile_repo.update(profile, data)
        return updated_profile
    
    def _validate_email_uniqueness(self, email: str, profile_id: int) -> None:
        if self.profile_repo.exists_by_email_excluding(email, profile_id):
            raise ServiceError("Email already exists", status_code=400)
```

