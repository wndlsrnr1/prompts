# ✅ CORRECT: Repository with proper error handling and abstraction
class EpisodeRepository:
    @staticmethod
    def create(data: dict) -> Episode:
        """Create episode with proper error handling."""
        try:
            return Episode.objects.create(**data)
        except IntegrityError as e:
            if 'unique_constraint' in str(e):
                raise DuplicateEpisodeError(f"Episode with title '{data.get('title')}' already exists")
            elif 'foreign_key' in str(e):
                raise InvalidReferenceError("Referenced series or category does not exist")
            else:
                raise DatabaseConstraintError(f"Database constraint violation: {e}")
        except ValidationError as e:
            raise InvalidDataError(f"Model validation failed: {e}")
```

**CONFIGURATION MANAGEMENT**:

```python
# ✅ CORRECT: Proper configuration with validation
class VideoProcessingConfig:
    """Centralized configuration with validation."""

    def __init__(self):
        self.hls_output_dir = self._get_required_setting('HLS_OUTPUT_DIR')
        self.ffmpeg_path = self._get_required_setting('FFMPEG_PATH')
        self.quality_profiles = self._get_quality_profiles()
        self.max_concurrent_jobs = self._get_int_setting('MAX_CONCURRENT_JOBS', default=3)

    def _get_required_setting(self, key: str) -> str:
        value = os.getenv(key)
        if not value:
            raise ConfigurationError(f"Required setting {key} is not configured")
        return value

    def _get_quality_profiles(self) -> List[QualityProfile]:
        profiles_json = os.getenv('QUALITY_PROFILES', '[]')
        try:
            profiles_data = json.loads(profiles_json)
            return [QualityProfile(**profile) for profile in profiles_data]
        except (json.JSONDecodeError, TypeError) as e:
            raise ConfigurationError(f"Invalid quality profiles configuration: {e}")
```

