--color-inf-snow: #f2f2f2; /* 연한 흰색 */
--color-inf-ash: #cbcfd2; /* 연한 회색 */
--color-inf-steel: #797c7e; /* 중간 회색 */
--color-inf-charcoal: #5d5d5d; /* 어두운 회색 */
--color-inf-shadow: #9b9b9b; /* 중간 회색 */
--color-inf-purple: #857aff; /* 보라색 */
