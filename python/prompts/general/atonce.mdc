# ✅ REPOSITORY INTERFACE FOR DATA ACCESS
class EpisodeRepositoryInterface(ABC):
    """Data access abstraction for episode entities"""

    @abstractmethod
    def create(self, data: Dict[str, Any]) -> Episode:
        pass

    @abstractmethod
    def get_by_id(self, episode_id: int) -> Optional[Episode]:
        pass

    @abstractmethod
    def get_by_series(self, series_id: int) -> List[Episode]:
        pass

class DjangoEpisodeRepository(EpisodeRepositoryInterface):
    """Django ORM implementation of episode repository"""

    def create(self, data: Dict[str, Any]) -> Episode:
        return Episode.objects.create(**data)

    def get_by_id(self, episode_id: int) -> Optional[Episode]:
        try:
            return Episode.objects.select_related('series', 'category').get(id=episode_id)
        except Episode.DoesNotExist:
            return None
```

