#### **Law of Demeter - Minimize Dependencies**

```python
# ❌ Poor Design: Violates Law of Demeter
class Team:
    def __init__(self):
        self.members = []

class TeamLeader:
    def get_team_member_salary(self, team, member_index):
        return team.members[member_index].salary  # Too many dots

# ✅ Good Design: Respect Law of Demeter
class Team:
    def __init__(self):
        self.members = []
    
    def get_member_salary(self, member_index):
        if 0 <= member_index < len(self.members):
            return self.members[member_index].get_salary()
        return None

class TeamLeader:
    def get_team_member_salary(self, team, member_index):
        return team.get_member_salary(member_index)  # Only one dot
```

**Team Leadership Application:**
- Minimize direct dependencies between team members
- Create clear communication channels
- Avoid complex chains of responsibility

### **Practical Team Management Implementation**

#### **Team Structure with Object-Oriented Principles**

```python
from abc import ABC, abstractmethod
from typing import List, Dict
from dataclasses import dataclass
from enum import Enum

class TaskPriority(Enum):
    LOW = 1
    MEDIUM = 2
    HIGH = 3
    CRITICAL = 4

@dataclass
class Task:
    name: str
    priority: TaskPriority
    estimated_hours: int
    assigned_to: str = None

class TeamMember(ABC):
    def __init__(self, name: str, role: str):
        self.name = name
        self.role = role
        self.current_tasks: List[Task] = []
    
    @abstractmethod
    def can_handle_task(self, task: Task) -> bool:
        pass
    
    def assign_task(self, task: Task):
        if self.can_handle_task(task):
            self.current_tasks.append(task)
            task.assigned_to = self.name
            return True
        return False
    
    def get_workload(self) -> int:
        return sum(task.estimated_hours for task in self.current_tasks)

class Developer(TeamMember):
    def can_handle_task(self, task: Task) -> bool:
        return "development" in task.name.lower() or "coding" in task.name.lower()

class Tester(TeamMember):
    def can_handle_task(self, task: Task) -> bool:
        return "test" in task.name.lower() or "qa" in task.name.lower()

class DevOps(TeamMember):
    def can_handle_task(self, task: Task) -> bool:
        return "deploy" in task.name.lower() or "infrastructure" in task.name.lower()

class Team:
    def __init__(self):
        self.members: List[TeamMember] = []
        self.tasks: List[Task] = []
    
    def add_member(self, member: TeamMember):
        self.members.append(member)
    
    def add_task(self, task: Task):
        self.tasks.append(task)
    
    def assign_tasks_optimally(self):
        """Assign tasks based on Single Responsibility Principle"""
        unassigned_tasks = [task for task in self.tasks if task.assigned_to is None]
        
        for task in unassigned_tasks:
            # Find the best team member for this task
            best_member = None
            min_workload = float('inf')
            
            for member in self.members:
                if member.can_handle_task(task) and member.get_workload() < min_workload:
                    best_member = member
                    min_workload = member.get_workload()
            
            if best_member:
                best_member.assign_task(task)
    
    def get_team_status(self) -> Dict:
        return {
            "total_members": len(self.members),
            "total_tasks": len(self.tasks),
            "assigned_tasks": len([t for t in self.tasks if t.assigned_to]),
            "member_workloads": {member.name: member.get_workload() for member in self.members}
        }

# Usage Example
def create_optimized_team():
    team = Team()
    
    # Add team members (Single Responsibility)
    team.add_member(Developer("Alice", "Backend Developer"))
    team.add_member(Developer("Bob", "Frontend Developer"))
    team.add_member(Tester("Charlie", "QA Engineer"))
    team.add_member(DevOps("Diana", "DevOps Engineer"))
    
    # Add tasks
    team.add_task(Task("Backend API Development", TaskPriority.HIGH, 40))
    team.add_task(Task("Frontend UI Development", TaskPriority.HIGH, 35))
    team.add_task(Task("Integration Testing", TaskPriority.MEDIUM, 20))
    team.add_task(Task("Deployment Pipeline Setup", TaskPriority.MEDIUM, 25))
    team.add_task(Task("Unit Testing", TaskPriority.LOW, 15))
    
    # Assign tasks optimally
    team.assign_tasks_optimally()
    
    return team

# Self-criticism questions for team leaders
def team_leadership_self_criticism():
    questions = [
        "Am I assigning tasks based on single responsibility principle?",
        "Is my team structure open for extension but closed for modification?",
        "Can team members substitute for each other when needed?",
        "Am I giving team members only the access they need?",
        "Am I depending on abstract goals rather than specific implementations?",
        "Am I protecting sensitive team member information appropriately?",
        "Am I building flexible team structures using composition?",
        "Am I minimizing direct dependencies between team members?"
    ]
    return questions
```

### **Team Leadership Checklist with Object-Oriented Principles**

* [ ] Apply Single Responsibility Principle to task assignments
* [ ] Use Open/Closed Principle for team structure changes
* [ ] Ensure team members can substitute for each other (LSP)
* [ ] Give team members only necessary access (ISP)
* [ ] Focus on abstract goals rather than specific implementations (DIP)
* [ ] Protect sensitive team member information (Encapsulation)
* [ ] Build flexible team structures using composition
* [ ] Minimize direct dependencies between team members (Law of Demeter)
* [ ] Practice self-criticism in all team management decisions
* [ ] Continuously improve team structure based on object-oriented principles


