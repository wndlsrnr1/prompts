#### ✅ CORRECT SERVICE-CENTRIC PATTERNS:

```python
# ✅ CORRECT: View using service
class EpisodeView(APIView):
    def __init__(self):
        self.episode_service = EpisodeService()
        self.serializer_service = EpisodeSerializerService(self.episode_service)

    def post(self, request):
        serializer = EpisodeCreateSerializer(data=request.data)
        if serializer.is_valid():
            # Use serializer service for validation
            validation_result = self.serializer_service.validate_episode_business_rules(serializer.validated_data)
            if validation_result.is_valid:
                # Use service for business logic
                episode = self.episode_service.create_episode(serializer.validated_data)
                return Response(EpisodeSerializer(episode).data, status=201)

# ✅ CORRECT: Serializer with SerializerService dependency
class EpisodeCreateSerializer(serializers.Serializer):
    title = serializers.CharField(max_length=200)

    def __init__(self, *args, **kwargs):
        self.serializer_service = kwargs.pop('serializer_service', None)
        super().__init__(*args, **kwargs)

    def validate(self, data):
        # Only input validation - business validation through service
        if not data.get('title', '').strip():
            raise serializers.ValidationError("Title cannot be empty")

        # Business validation through SerializerService
        if self.serializer_service:
            validation_result = self.serializer_service.validate_episode_business_rules(data)
            if not validation_result.is_valid:
                raise serializers.ValidationError(validation_result.errors)

        return data
```

