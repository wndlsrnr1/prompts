**Standardization Rule**:
```python
# Add service template pattern to django-architecture.mdc
class BaseService:
    """Base service with standardized error handling."""
    
    @classmethod
    def execute_operation(cls, operation_func, *args, **kwargs):
        try:
            result = operation_func(*args, **kwargs)
            return ServiceResult.success(data=result)
        except ValidationError as e:
            logger.warning(f"Validation error in {cls.__name__}: {e}")
            return ServiceResult.failure(errors=e.messages)
        except Exception as e:
            logger.error(f"Unexpected error in {cls.__name__}: {e}", exc_info=True)
            return ServiceResult.failure(errors=['Internal server error'])
```

