# ✅ STANDARD SERVICE INTERFACE PATTERN
from abc import ABC, abstractmethod
from typing import Dict, Any, Optional

class ContentServiceInterface(ABC):
    """Standard service interface for content management"""

    @abstractmethod
    def create_content(self, data: Dict[str, Any]) -> Dict[str, Any]:
        pass

    @abstractmethod
    def get_content_by_id(self, content_id: int) -> Optional[Dict[str, Any]]:
        pass

class EpisodeService(ContentServiceInterface):
    """Episode management service with business logic encapsulation"""

    def __init__(self,
                 episode_repository: EpisodeRepositoryInterface,
                 validation_service: EpisodeValidationService,
                 config: EpisodeServiceConfig):
        self._episode_repository = episode_repository
        self._validation_service = validation_service
        self._config = config

    def create_content(self, data: Dict[str, Any]) -> Dict[str, Any]:
        # Business logic implementation
        validation_result = self._validation_service.validate_episode_business_rules(data)
        if not validation_result.is_valid:
            raise BusinessLogicError(validation_result.errors)

        episode = self._episode_repository.create(data)
        return self._format_episode_response(episode)
```

